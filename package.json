{
  "name": "viaferrata",
  "version": "0.1.0",
  "private": true,
  "description": "Create change documents and validate their basic structure",
  "license": "MIT",
  "bin": {
    "vf": "dist/bin/vf.js"
  },
  "files": [
    "dist",
    "templates",
    "instructions",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings bin src scripts && markdownlint-cli2",
    "lint:fix": "oxlint --deny-warnings --fix bin src scripts && markdownlint-cli2 --fix",
    "prepack": "npm run build",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:all": "npm test && npm run test:package",
    "test:package": "node --test src/tests/package.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "remark-parse": "11.0.0",
    "smol-toml": "1.9.1",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/unist": "3.0.3",
    "markdownlint-cli2": "0.24.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
