{
  "name": "viaferrata",
  "version": "0.1.0",
  "private": true,
  "description": "Create change documents and validate their basic structure",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "vf": "dist/bin/vf.js"
  },
  "files": [
    "dist",
    "templates",
    "instructions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "node scripts/build.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "remark-parse": "11.0.0",
    "smol-toml": "1.9.1",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/unist": "3.0.3",
    "typescript": "7.0.2"
  }
}
